name: AM++ AutoMix 1.3.5 cloud build

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: automix-cloud-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Patch, test and package plugin
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install exact Android SDK packages
        run: |
          yes | sdkmanager --licenses >/dev/null
          sdkmanager --install "platforms;android-37" "build-tools;37.0.0"

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Verify patch anchors
        run: python apply_automix_quality_patch.py

      - name: Apply AutoMix quality patch
        run: python apply_automix_quality_patch.py --apply

      - name: Run tests and build plugin ZIP
        run: |
          chmod +x ./gradlew
          ./gradlew --no-daemon --stacktrace \
            :media-plugin:testDebugUnitTest \
            :media-plugin:pluginZip

      - name: Upload installable plugin ZIP
        uses: actions/upload-artifact@v4
        with:
          name: AMPP-AutoMix-1.3.5-plugin
          path: media-plugin/build/dist/ampp-media-integrations-1.3.5.zip
          if-no-files-found: error
          retention-days: 14

      - name: Upload diagnostics if build fails
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: AMPP-AutoMix-build-diagnostics
          path: |
            media-plugin/build/reports/**
            media-plugin/build/test-results/**
            media-plugin/build/outputs/**
          if-no-files-found: ignore
          retention-days: 7
